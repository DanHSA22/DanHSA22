# ===========================
# Anthropic / Claude API
# ===========================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# Configuração do Bot
# ===========================

# IDs dos canais WhatsApp para receber as mensagens
# Formato: {id}@newsletter  (ex: 12345678901@newsletter)
# Separe múltiplos canais com vírgula
WHATSAPP_CHANNEL_IDS=120363xxxxxxxxxx@newsletter

# Horários de envio (formato cron: "minuto hora * * *")
# Padrão: 8h, 12h e 19h
CRON_MORNING=0 8 * * *
CRON_AFTERNOON=0 12 * * *
CRON_EVENING=0 19 * * *

# ===========================
# Links de Afiliado Amazon
# ===========================
# Seu ID de afiliado Amazon Associates
AMAZON_AFFILIATE_ID=seuid-20

# ===========================
# API de Gerenciamento (opcional)
# ===========================
API_PORT=3000
API_SECRET=sua-chave-secreta-aqui

# ===========================
# Configurações de Conteúdo
# ===========================
# Idioma das mensagens (pt-BR, en-US, es-ES)
CONTENT_LANGUAGE=pt-BR

# Categoria de livros preferida (negócios, desenvolvimento-pessoal, espiritualidade, todos)
BOOK_CATEGORY=todos

# Número de livros recomendados por mensagem
BOOKS_PER_MESSAGE=2
