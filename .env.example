# ── Mercado Livre ──────────────────────────────────────────────
ML_APP_ID=
ML_SECRET_KEY=
ML_SITE_ID=MLB

# ── Filtros ────────────────────────────────────────────────────
MIN_DISCOUNT_PERCENT=15
MAX_PRICE=0
KEYWORDS=iphone,samsung,notebook,playstation
CATEGORIES=
MAX_OFFERS_PER_RUN=5

# ── Agendamento ────────────────────────────────────────────────
SCHEDULE_INTERVAL_MINUTES=30

# ── WhatsApp (Green API) ───────────────────────────────────────
# Obtidos em: https://console.green-api.com
GREEN_API_ID_INSTANCE=1101xxxxxxx
GREEN_API_TOKEN=seu_token_aqui

# ID do grupo WhatsApp (formato: 120363xxxxxxx@g.us)
# Para obter: veja o guia no README
WHATSAPP_GROUP_ID=

# ── Controle de duplicatas ─────────────────────────────────────
SENT_OFFERS_FILE=sent_offers.json
