# ── Mercado Livre ──────────────────────────────────────────────
# Opcional: credenciais de app aumentam o rate limit da API
ML_APP_ID=
ML_SECRET_KEY=

# Site: MLB = Brasil | MLA = Argentina | MLM = México
ML_SITE_ID=MLB

# ── Filtros ────────────────────────────────────────────────────
# Desconto mínimo em % para postar (0 = sem filtro)
MIN_DISCOUNT_PERCENT=15

# Preço máximo em R$ (0 = sem limite)
MAX_PRICE=0

# Palavras-chave separadas por vírgula (deixe vazio para qualquer produto)
KEYWORDS=iphone,samsung,notebook,playstation

# IDs de categoria separados por vírgula (deixe vazio para todas)
# Exemplo: MLB1051=Celulares, MLB1648=Computadores, MLB1144=Games
CATEGORIES=

# Máximo de ofertas postadas por execução
MAX_OFFERS_PER_RUN=5

# ── Agendamento ────────────────────────────────────────────────
# Intervalo em minutos entre cada busca
SCHEDULE_INTERVAL_MINUTES=30

# ── WhatsApp (Evolution API) ───────────────────────────────────
# URL do seu servidor Evolution API
EVOLUTION_API_URL=http://localhost:8080

# Chave de API definida na configuração do Evolution API
EVOLUTION_API_KEY=sua_chave_aqui

# Nome da instância criada no Evolution API
EVOLUTION_INSTANCE=minha-instancia

# ID do grupo WhatsApp (formato: 120363xxxxxxx@g.us)
# Para obter: no Evolution API use GET /group/fetchAllGroups/{instance}
WHATSAPP_GROUP_ID=

# ── Controle de duplicatas ─────────────────────────────────────
SENT_OFFERS_FILE=sent_offers.json
